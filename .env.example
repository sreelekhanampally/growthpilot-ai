GROWTHPILOT_UCI_URL=https://archive.ics.uci.edu/static/public/502/online+retail+ii.zip
DATABASE_URL=postgresql+psycopg://growthpilot:growthpilot@localhost:5432/growthpilot
WORKSPACE_SLUG=demo-retail
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
# Multi-agent copilot: deterministic | gemini | ollama | hybrid
# The application remains fully usable in deterministic mode with no API key.
LLM_PROVIDER=deterministic
HYBRID_PRIMARY=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_COOLDOWN_SECONDS=65
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_KEEP_ALIVE=10m
